GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Showcase chefs visible on marketing but not bookable (Instagram links)
SHOWCASE_ONLY_CHEFS=true

# Google OAuth (Sign in with Google via Supabase Auth)
# Create a Web client in Google Auth Platform, then paste Client ID + Secret here for local Auth.
# Dashboard (hosted): https://supabase.com/dashboard/project/hmwlaaikpwaethdpuqtf/auth/providers?provider=Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Supabase
SUPABASE_PROJECT_REF=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=
DATABASE_URL=
DATABASE_URL_DIRECT=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public app URL used in chef emails / WhatsApp messages
APP_URL=

# Chef Nana K. notification targets + portal password
CHEF_NANA_EMAIL=
CHEF_NANA_WHATSAPP=
CHEF_NANA_PASSWORD=

# Signs chef portal cookies and request access-token hashes
CHEF_SESSION_SECRET=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=

# WhatsApp via Twilio. Inbound webhook: POST /api/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=

# Optional JSON webhook for tests: Authorization: Bearer <secret>
WHATSAPP_WEBHOOK_SECRET=

# Sumsub chef identity verification (sandbox tokens start with sbx:)
# Dashboard: https://cockpit.sumsub.com - Sandbox → App tokens
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_CHEF_LEVEL_NAME=id-and-liveness
SUMSUB_API_URL=https://api.sumsub.com
# Webhook URL to register in Sumsub: https://your-host/api/sumsub/webhook

